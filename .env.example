# Copy to .env.local and fill in from Supabase > Project Settings.
# Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings > API Keys (legacy tab): anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings > API Keys (legacy tab): service_role secret key. Server only, never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The database password chosen when the project was created. Only the migrate script uses it.
SUPABASE_PASSWORD=your-database-password
